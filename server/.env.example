# Free Code Hub — server environment
# Copy to server/.env and adjust. All values have safe demo defaults.

PORT=5000
# MongoDB connection string. When unset the API boots a fully-interactive
# IN-MEMORY demo (register, solve, XP, checkout all work; data resets on restart).
MONGO_URI=mongodb://localhost:27017/free-code-hub

JWT_SECRET=change-me-to-a-long-random-string

# Origin of the Vite dev server (CORS + Socket.IO)
CLIENT_ORIGIN=http://localhost:5173

# Mock Stripe publishable key (payments are SIMULATED in this build)
STRIPE_MOCK_PUBLISHABLE_KEY=pk_test_mock_free_code_hub
